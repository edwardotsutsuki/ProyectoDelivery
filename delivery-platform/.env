# ==============================================================================
# VARIABLES DE ENTORNO - PLATAFORMA DE DELIVERY
# ==============================================================================

NODE_ENV=development
JWT_SECRET=delivery_jwt_secret_key_ultra_secure_2026

# Base de Datos (PostgreSQL 15 + PostGIS 3.3)
POSTGRES_USER=delivery_admin
POSTGRES_PASSWORD=delivery_secure_pass_2026
POSTGRES_DB=delivery_db
POSTGRES_HOST=db-postgis
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
DATABASE_URL=postgresql://delivery_admin:delivery_secure_pass_2026@db-postgis:5432/delivery_db

# Cache & In-Memory Store (Redis 7)
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380
REDIS_URL=redis://redis-cache:6379

# Motor de Rutas y Geodesia (OSRM Local)
OSRM_HOST=osrm-backend
OSRM_PORT=5000
OSRM_EXTERNAL_PORT=5001
OSRM_URL=http://osrm-backend:5000

# Backend Core (Monolito Modular API)
BACKEND_CORE_PORT=3000
BACKEND_CORE_EXTERNAL_PORT=3001

# Servicio de Geolocalización en Tiempo Real (WebSocket)
TRACKING_SERVICE_PORT=4000
TRACKING_SERVICE_EXTERNAL_PORT=4001

# API Gateway (Nginx)
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443

# Aplicaciones Frontend (Puertos de Desarrollo)
FRONTEND_LANDING_PORT=3002
FRONTEND_COMERCIO_PORT=3003
FRONTEND_BACKOFFICE_PORT=3004

