VITE_API_BASE_URL=http://localhost:8080/api/v1
# Merchant scope comes from the authenticated server profile (user.comercioId).
VITE_TRACKING_URL=ws://localhost:8080/ws/
VITE_TRACKING_DIRECT_URL=ws://localhost:4001
VITE_OSRM_URL=http://localhost:5001
# Verified against Gateway; set false explicitly to disable automatic renewal.
VITE_AUTH_REFRESH_ENABLED=true
# Demos default to enabled in development and disabled in production.
VITE_ENABLE_DEMOS=false
